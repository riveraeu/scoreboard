{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/[...path].js": { "maxDuration": 300 }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/[...path]" },
    { "source": "/:slug", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/keepalive", "schedule": "0 12 * * *" },
    { "path": "/api/kalshi-snapshot", "schedule": "*/10 * * * *" },
    { "path": "/api/tonight", "schedule": "0 15 * * *" },
    { "path": "/api/shadow-snapshot", "schedule": "5 15 * * *" },
    { "path": "/api/shadow-snapshot", "schedule": "10 15 * * *" },
    { "path": "/api/tonight", "schedule": "0 22 * * *" },
    { "path": "/api/shadow-snapshot", "schedule": "5 22 * * *" },
    { "path": "/api/shadow-snapshot", "schedule": "40 22 * * *" },
    { "path": "/api/tonight", "schedule": "55 16 * * *" },
    { "path": "/api/shadow-pregame-snap", "schedule": "0 17 * * *" },
    { "path": "/api/shadow-pregame-snap", "schedule": "10 22 * * *" },
    { "path": "/api/tonight", "schedule": "55 2 * * *" },
    { "path": "/api/shadow-pregame-snap", "schedule": "0 3 * * *" },
    { "path": "/api/tonight", "schedule": "25 19 * * *" },
    { "path": "/api/shadow-pregame-snap", "schedule": "30 19 * * *" },
    { "path": "/api/tonight", "schedule": "25 0 * * *" },
    { "path": "/api/shadow-pregame-snap", "schedule": "30 0 * * *" },
    { "path": "/api/shadow-resolver", "schedule": "0 9 * * *" },
    { "path": "/api/shadow-resolver", "schedule": "5 10 * * *" },
    { "path": "/api/shadow-resolver", "schedule": "50 12 * * *" },
    { "path": "/api/kalshi-series-scan", "schedule": "45 12 * * *" },
    { "path": "/api/shadow-report", "schedule": "0 13 * * *" }
  ]
}
